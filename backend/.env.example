# Banco de Dados
# Para produção (Neon/Vercel), use sslmode=verify-full para máxima segurança
# Exemplo: postgresql://user:pass@host/db?sslmode=verify-full
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alimentacao_escolar
DATABASE_SSL=false

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Redis (produção recomendado - se não configurado, usa cache em memória)
# REDIS_URL=redis://default:password@host:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Servidor
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Logs
LOG_LEVEL=info

# Chatbot LLM
CHATBOT_ENABLED=false
CHATBOT_PROVIDER=openai_compatible
CHATBOT_MODEL=gemini-2.5-flash-lite
CHATBOT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CHATBOT_TIMEOUT_MS=120000
CHATBOT_TEMPERATURE=0.2
# Gemini API key do Google AI Studio.
# CHATBOT_API_KEY=

# Storage
# STORAGE_PROVIDER=local
# Produção recomendado:
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION=us-east-1
# AWS_S3_BUCKET=
# AWS_S3_PUBLIC_BASE=https://cdn.example.com

# Sentry (Opcional)
# SENTRY_DSN=

# Vercel
VERCEL=0
